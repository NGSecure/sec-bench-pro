+var type = builder2.addType(makeSig([wasmRefType(struct1), kWasmI64], []));
+
+for(let i = 0; i < 2; i++)
+    builder2.addImport('test', 'write', type);
+var importIdx = builder2.addImport('test', 'write', type); // use func type of index 2 (dummy)
