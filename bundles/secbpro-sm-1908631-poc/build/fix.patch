From 5a54e992206bf047493b1081886b364fe21837d7 Mon Sep 17 00:00:00 2001
From: Ben Visness <bvisness@mozilla.com>
Date: Mon, 22 Jul 2024 21:04:37 +0000
Subject: [PATCH] Bug 1908631: Add missing dead code check in table.fill.
 r=rhunt

Differential Revision: https://phabricator.services.mozilla.com/D217310
---
 js/src/wasm/WasmBaselineCompile.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/js/src/wasm/WasmBaselineCompile.cpp b/js/src/wasm/WasmBaselineCompile.cpp
index 5c1a3fd76587a..b397ec491c2d6 100644
--- a/js/src/wasm/WasmBaselineCompile.cpp
+++ b/js/src/wasm/WasmBaselineCompile.cpp
@@ -6736,6 +6736,9 @@ bool BaseCompiler::emitTableFill() {
   if (!iter_.readTableFill(&tableIndex, &nothing, &nothing, &nothing)) {
     return false;
   }
+  if (deadCode_) {
+    return true;
+  }
 
   IndexType indexType = codeMeta_.tables[tableIndex].indexType();
 
From c3216db173b3631a656a2feb519f572b6837489a Mon Sep 17 00:00:00 2001
From: Ben Visness <bvisness@mozilla.com>
Date: Tue, 23 Jul 2024 13:34:01 +0000
Subject: [PATCH] Bug 1908631: Add test for dead code in table.fill. r=rhunt

Differential Revision: https://phabricator.services.mozilla.com/D217312
---
 js/src/jit-test/tests/wasm/bug1908631.js | 12 ++++++++++++
 1 file changed, 12 insertions(+)
 create mode 100644 js/src/jit-test/tests/wasm/bug1908631.js

diff --git a/js/src/jit-test/tests/wasm/bug1908631.js b/js/src/jit-test/tests/wasm/bug1908631.js
new file mode 100644
index 0000000000000..4eb2c40b56e9f
--- /dev/null
+++ b/js/src/jit-test/tests/wasm/bug1908631.js
@@ -0,0 +1,12 @@
+// |jit-test| skip-if: !wasmIsSupported()
+
+const bytes = wasmTextToBinary(`(module
+  (table 0 externref)
+  (func
+    block
+      unreachable
+      table.fill 0
+  )
+)`);
+assertEq(WebAssembly.validate(bytes), false);
+assertErrorMessage(() => new WebAssembly.Module(bytes), WebAssembly.CompileError, /unable to read opcode/);
